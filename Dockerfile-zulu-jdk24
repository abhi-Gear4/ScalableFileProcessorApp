# Stage 1: Download and unpack Zulu JDK
FROM ubuntu:22.04 as builder

# Add and extract the JDK
ADD https://cdn.azul.com/zulu/bin/zulu24.32.13-ca-crac-jdk24.0.2-linux_aarch64.tar.gz /opt/
RUN cd /opt/ && \
    tar -xzf zulu24.32.13-ca-crac-jdk24.0.2-linux_aarch64.tar.gz && \
    rm -f zulu24.32.13-ca-crac-jdk24.0.2-linux_aarch64.tar.gz

# Stage 2: Final image with Java and Docker CLI
FROM ubuntu:22.04

# Copy JDK from builder stage
COPY --from=builder /opt/zulu24.32.13-ca-crac-jdk24.0.2-linux_aarch64 /opt/zulu24.32.13-ca-crac-jdk24.0.2-linux_aarch64

# Set Java environment variables
ENV JAVA_HOME=/opt/zulu24.32.13-ca-crac-jdk24.0.2-linux_aarch64
ENV PATH="$JAVA_HOME/bin:$PATH"

# Install system dependencies including docker.io
RUN set -ex && \
    apt-get -qq update && \
    apt-get -qq install -y --no-install-recommends \
        locales \
        tzdata \
        docker.io && \
    echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen en_US.UTF-8 && \
    apt-get -qq -y dist-upgrade && \
    apt-get -qq -y autoremove && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
